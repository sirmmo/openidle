# Levels 1 and 2: the hearth and the forge. Sparks by hand, then by kindlers, bellows and hearths;
# forges burn sparks into embers, which are hard to store.

milestone L1
    view tier 1
    label Level 1 · The hearth
    text Strike sparks and build kindlers.
    if 1
    view kind level
end

milestone L2
    view tier 2
    label Level 2 · The forge
    text Build a forge.
    if Forge >= 1
    do add Gems 1
    view kind level
end

resource Sparks
    text The fire you make.
    view color #f5a623
end

resource Embers
    text Forged from sparks; their store is small.
    cap $ember_cap * 1.6 ^ Brazier * if(Cassiopeia, 4, 1) * if(Hearthstone, 10, 1)
    show if L2
    view color #e0532f
end

resource Strikes
    text Times you struck a spark.
    hidden
end

# ------------------------------------------------------------------ clicking

action strike
    label Strike
    text Strike a spark by hand.
    out Sparks $strike * (1 + Flint) * (1 + 4 * Calloused) * (1 + 0.01 * Kindler * Tinder)
    do add Strikes 1
end

action focus
    label Focus
    text Everything goes three times as fast for ten seconds.
    cooldown 60
    lasts 10
    boost all 3
    show if Kindler >= 5
end

action stoke
    label Stoke
    text Half fill the ember store at once.
    out Embers cap(Embers) / 2
    cooldown 90
    show if L2
end

# ------------------------------------------------------------------ generators

generator Kindler
    text Makes sparks.
    cost Sparks 10 * $growth ^ owned
end

rule kindle
    appliesTo Kindler
    out Sparks $kindler_rate
end

generator Bellows
    text Makes many more sparks.
    cost Sparks 120 * 1.17 ^ owned
    show if Kindler >= 3
end

rule blow
    appliesTo Bellows
    out Sparks $bellows_rate
end

generator Hearth
    text A great fire: makes sparks by the hundred.
    cost Sparks 15000 * 1.19 ^ owned
    show if Bellows >= 8
end

rule roar
    appliesTo Hearth
    out Sparks $hearth_rate
end

generator Forge
    text Burns sparks into embers.
    cost Sparks 1000 * 1.2 ^ owned
    show if Bellows >= 2
end

rule forge
    appliesTo Forge
    in Sparks $forge_burn
    out Embers $forge_make
end

generator Brazier
    text Holds 60% more embers.
    cost Sparks 3000 * 1.8 ^ owned
    cost Embers 40 * 1.45 ^ owned
    show if Embers >= 25
end

# ------------------------------------------------------------------ upgrades

upgrade Flint
    text Strikes give twice as much.
    cost Sparks 50
    show if total(Sparks) >= 20
end

upgrade Tinder
    text Strikes give 1% more for every kindler.
    cost Sparks 500
    show if Kindler >= 10
end

upgrade DryWood
    label Dry wood
    text Kindlers make twice as much.
    cost Sparks 200
    boost Kindler 2
    show if Kindler >= 5
end

upgrade Oak
    text Kindlers make three times as much.
    cost Sparks 100000
    boost Kindler 3
    show if Kindler >= 25
end

upgrade Leather
    label Leather bellows
    text Bellows make twice as much.
    cost Sparks 2000
    boost Bellows 2
    show if Bellows >= 5
end

upgrade Chimney
    text Hearths make twice as much.
    cost Sparks 500000
    boost Hearth 2
    show if Hearth >= 5
end

upgrade Tongs
    text Forges work twice as fast.
    cost Sparks 20000
    cost Embers 30
    boost Forge 2
    show if Forge >= 3
end

upgrade Glow
    label Ember glow
    text Every ember you hold makes sparks 1% faster, up to three times as fast.
    cost Embers 40
    boost Sparks min(3, 1 + 0.01 * Embers)
    show if Embers >= 20
end

upgrade Thrift
    text Everything costs 10% less.
    cost Embers 100
    discount all 0.9
    show if Brazier >= 1
end
